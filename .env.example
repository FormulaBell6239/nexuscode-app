# NexusCode — Environment Variables Reference
# Copy the relevant sections to backend/.env and frontend/.env.local

# ─── BACKEND (backend/.env) ───────────────────────────────────────────────────

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL (local dev default — change for staging/production)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres   # local dev only. In production use 24+ random chars and a non-superuser DB_USERNAME
DB_NAME=nexuscode

# Production only: set DB_SSL=true when DB_HOST is a remote database
# DB_SSL=true

# JWT — MUST be changed before deploying to production
JWT_SECRET=change_me_in_production   # generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d

# ─── FRONTEND (frontend/.env.local) ───────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:3001
