# NexusCode — Environment Variables Reference
# Copy the relevant sections to backend/.env and frontend/.env.local

# ─── BACKEND (backend/.env) ───────────────────────────────────────────────────

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL (local dev default — change for staging/production)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nexuscode

# JWT — MUST be changed before deploying to production
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# ─── FRONTEND (frontend/.env.local) ───────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:3001
